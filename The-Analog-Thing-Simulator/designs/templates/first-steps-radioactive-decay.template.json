{
  "schemaVersion": "analog-thing-design-template/v1",
  "id": "first-steps-radioactive-decay",
  "title": "First Steps: Radioactive Decay",
  "category": "First Steps application",
  "description": "Section 9.1 exponential decay patch with one integrator, one inverter, and two coefficient potentiometers.",
  "sourceDesignId": "first-steps-radioactive-decay",
  "defaultMode": "REPF",
  "runnable": true,
  "tags": [
    "first-steps",
    "radioactive-decay",
    "design-template"
  ],
  "walkthrough": [
    {
      "title": "Set the initial amount",
      "text": "PLUS1 feeds P1, so P1 directly sets N0 in the machine-unit range. The P1 output goes to I1.ic, which initializes the integrator output to -N0.",
      "socketFocus": [
        "PLUS1.out",
        "P1.in",
        "P1.out",
        "I1.ic"
      ],
      "controlFocus": [
        "P1"
      ]
    },
    {
      "title": "Close the decay feedback loop",
      "text": "I1.out carries -N and is fed through P2. Because the integrator inverts its input, this loop implements Ndot = -lambda*N.",
      "socketFocus": [
        "I1.out",
        "P2.in",
        "P2.out",
        "I1.in1"
      ],
      "controlFocus": [
        "P2"
      ]
    },
    {
      "title": "Display positive N",
      "text": "INV1 changes -N back to N and routes the decay curve to OUT X for repeated-sweep display in REPF mode.",
      "socketFocus": [
        "I1.out",
        "INV1.in",
        "INV1.out",
        "OUT_X.in"
      ],
      "controlFocus": [
        "X"
      ]
    }
  ],
  "runOptions": {
    "mode": "REPF",
    "opTime": 8,
    "cycles": 3,
    "dt": 0.01,
    "sampleEvery": 50
  },
