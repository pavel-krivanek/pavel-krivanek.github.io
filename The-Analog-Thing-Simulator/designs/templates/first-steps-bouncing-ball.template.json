  "walkthrough": [
    {
      "title": "Store position and velocity",
      "text": "CAP1 and CAP3 store horizontal and vertical velocities, while CAP2 and CAP4 store the x and y positions. Velocity outputs feed the corresponding position capacitor inputs.",
      "socketFocus": [
        "CAP1.out",
        "CAP2.in",
        "CAP3.out",
        "CAP4.in"
      ]
    },
    {
      "title": "Detect horizontal wall contact",
      "text": "D1 detects x beyond +1 and D2 detects -x beyond +1 after INV1. SUM1 turns those ideal diode overdrive signals into horizontal rebound acceleration with light drag.",
      "socketFocus": [
        "CAP2.out",
        "D1.in",
        "INV1.out",
        "D2.in",
        "D1.out",
        "D2.out",
        "SUM1.out",
        "CAP1.in"
      ]
    },
    {
      "title": "Detect floor and ceiling contact",
      "text": "ZD1 emits floor overdrive for y>+1 and ZD2 emits ceiling overdrive for y<-1. D3 passes the floor contact contribution into SUM2.",
      "socketFocus": [
        "CAP4.out",
        "ZD1.in",
        "ZD2.in",
        "ZD1.out",
        "D3.in",
        "D3.out",
        "SUM2.floor"
      ]
    },
    {
      "title": "Display the trajectory",
      "text": "OUT X receives horizontal position x. CAP4 stores the booklet physical y coordinate, INV2 forms display Y = -physical y, and OUT Y receives that inverted signal so the floor bounce appears at the bottom of an X/Y display. OUT Z and OUT U expose velocity diagnostics.",
      "socketFocus": [
        "CAP4.out",
        "INV2.in",
        "INV2.out",
        "OUT_X.in",
        "OUT_Y.in",
        "OUT_Z.in",
        "OUT_U.in"
      ],
      "controlFocus": [
        "X",
        "Y",
        "Z",
        "U"
      ]
    }
  ],
